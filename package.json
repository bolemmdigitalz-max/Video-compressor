{
  "name": "compressly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-local image and video compressor. No uploads, no backend.",
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-assets.mjs",
    "vendor:ffmpeg": "node scripts/copy-ffmpeg-assets.mjs",
    "predev": "node scripts/copy-ffmpeg-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-ffmpeg-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
